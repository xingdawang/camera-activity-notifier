{
  "manifest_version": 3,
  "name": "Camera Activity Notifier",
  "version": "1.0.0",
  "description": "Locally notify the camera activity LED when a user-initiated ChatGPT response completes.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*"], "js": ["selectors.js", "routing.js", "content.js"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "action": { "default_title": "Camera Activity Notifier settings" }
}
